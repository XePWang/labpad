{
  "name": "labpad",
  "version": "0.1.0-dev.1",
  "description": "C 语言实验自测与源码导出工具",
  "author": "Wang Xianlin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "../.work/build/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "tools": "node scripts/prepare-tools.mjs",
    "package": "npm run build && electron-builder --config electron-builder.cjs",
    "native": "node scripts/setup-native.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "6.43.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.2",
    "iconv-lite": "^0.7.0",
    "node-pty": "1.1.0",
    "tree-kill": "^1.2.2",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "45.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.0",
    "node-gyp": "12.4.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.3"
  }
}

@top Program { (Call | Semicolon)* }
Call { Name "(" Arguments? ")" }
Arguments { String (Comma String)* Comma? }
Comma { "," }
Semicolon { ";" }
@skip { space | Comment | BlockComment }
@tokens {
  @precedence { BlockComment, Comment }
  space { @whitespace+ }
  Comment { "#" ![\n\r]* | "--" ![\n\r]* }
  BlockComment { "--[[" ( ![\]] | "]" ![\]] )* "]]" }
  Name { $[a-zA-Z_] $[a-zA-Z_0-9]* }
  String { "\"" ( !["\\\n\r] | "\\" ![\n\r] )* "\"" | "'" ( !['\\\n\r] | "\\" ![\n\r] )* "'" }
}

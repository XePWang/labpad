    {
      "problemId": "Lab 3-3",
      "title": "猜数字游戏（交互调试）",
      "language": "c",
      "source": [
        "#include <stdio.h>",
        "#include <stdlib.h>",
        "#include <time.h>",
        "",
        "int main(void) {",
        "    // 随机交互题：测试点留空，编译成功后在下方“调试”页试玩。",
        "    // 设计子函数：每轮生成随机数，最多猜 7 次，并根据猜测提示大小。",
        "    // 猜对时显示 Correct；用完机会后告知正确答案。",
        "    // 主函数支持继续或结束游戏，在注释中说明操作方式。",
        "    // 手动检查（在临时调试副本中固定答案，检查后恢复随机生成）：",
        "    // 01 首次猜中：显示 Correct，立即结束本轮。",
        "    // 02 猜大：提示偏大，并允许继续猜测。",
        "    // 03 猜小：提示偏小，并允许继续猜测。",
        "    // 04 第 7 次猜中：仍按成功处理。",
        "    // 05 连续 7 次猜错：结束本轮并显示正确答案，不再索要第 8 次猜测。",
        "    // 06 提前猜中：本轮剩余次数不再索要输入。",
        "    // 07 成功后继续：进入新一轮，恢复 7 次机会。",
        "    // 08 失败后继续：进入新一轮，恢复 7 次机会。",
        "    // 09 成功或失败后退出：按注释约定的操作正常结束程序。",
        "    // 10 连玩多轮：随机生成在每轮执行；不要求相邻两轮答案一定不同。",
        "    return 0;",
        "}"
      ],
      "comparison": {
        "type": "wcmp"
      },
      "testCases": []
    },
    {
      "problemId": "Lab 3-4",
      "title": "牛顿迭代法求三次方程（选做）",
      "language": "c",
      "source": [
        "#include <stdio.h>",
        "#include <math.h>",
        "",
        "int main(void) {",
        "    double a, b, x0, epsilon;",
        "    if (scanf(\"%lf%lf%lf%lf\", &a, &b, &x0, &epsilon) != 4) return 0;",
        "    // 设计自定义函数，用牛顿迭代求解 x^3 - a*x - b = 0。",
        "    // 本项目统一格式：标签后保留一个空格，输出 \"Iterations: %d\\nRoot: %.6f\\n\"。",
        "    // 初始次数为 0；每轮先检查 |f'(x)| < 1e-12 或 |f(x)| < epsilon，满足则退出。",
        "    // 否则计算下一估计值，次数加 1；更新 x 后，若 |新值 - 旧值| < epsilon 则退出。",
        "    // 初值已满足条件时输出次数 0；数值 token 的绝对/相对误差均为 1e-5，满足其一即通过。",
        "    return 0;",
        "}"
      ],
      "comparison": {
        "type": "floatTokens",
        "absoluteTolerance": 1e-05,
        "relativeTolerance": 1e-05
      },
      "testCases": [
        {
          "id": "guide-iteration",
          "input": "2 2 1.5 0.000001\n",
          "expectedOutput": "Iterations: 4\nRoot: 1.769292\n"
        },
        {
          "id": "guide-initial-root",
          "input": "3 2 2 0.000001\n",
          "expectedOutput": "Iterations: 0\nRoot: 2.000000\n"
        },
        {
          "id": "positive-root",
          "input": "0 8 1 1e-8\n",
          "expectedOutput": "Iterations: 6\nRoot: 2.000000\n"
        },
        {
          "id": "negative-root",
          "input": "0 -8 -1 1e-8\n",
          "expectedOutput": "Iterations: 6\nRoot: -2.000000\n"
        },
        {
          "id": "irrational-root",
          "input": "1 1 1 1e-8\n",
          "expectedOutput": "Iterations: 5\nRoot: 1.324718\n"
        },
        {
          "id": "zero-root",
          "input": "0 0 0 0.000001\n",
          "expectedOutput": "Iterations: 0\nRoot: 0.000000\n"
        },
        {
          "id": "derivative-zero",
          "input": "3 1 1 1e-6\n",
          "expectedOutput": "Iterations: 0\nRoot: 1.000000\n"
        },
        {
          "id": "initial-residual",
          "input": "0 8 2.000001 0.0001\n",
          "expectedOutput": "Iterations: 0\nRoot: 2.000001\n"
        },
        {
          "id": "step-threshold",
          "input": "0 1000000 100.00001 0.0001\n",
          "expectedOutput": "Iterations: 1\nRoot: 100.000000\n"
        },

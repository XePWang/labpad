        "",
        "int main(void) {",
        "    int n = 0;",
        "    if (scanf(\"%d\", &n) != 1) return 0;",
        "    // 第一个人的速度为 25 米/分钟，游泳时间为 2 分钟。",
        "    // 后一个人的速度是前一个人的 2 倍，游泳时间多 2 分钟。",
        "    // 计算 n 个人的总距离，只输出一个整数和换行。",
        "    return 0;",
        "}"

          "expectedOutput": "5\n7\n11\n101\n131\n151\n181\n191\n313\n353\n373\n383\n"
        }
      ]
    },
    {
      "problemId": "Lab 2-4",
      "title": "优先编码器（选做）",
      "source": [
        "#include <stdio.h>",
        "",
        "int main(void) {",
        "    // 读取四个连续的 0/1 字符，依次对应 A3、A2、A1、A0。",
        "    // 输出最高优先级有效输入的编码，或无输入信号提示。",
        "    return 0;",
        "}"
      ],
      "testCases": [
        {
          "id": "a3",
          "input": "1010\n",
          "expectedOutput": "A3的编码是11\n"
        },
        {
          "id": "a2",
          "input": "0111\n",
          "expectedOutput": "A2的编码是10\n"
        },
        {
          "id": "a1",
          "input": "0011\n",
          "expectedOutput": "A1的编码是01\n"
        },
        {
          "id": "a0",
          "input": "0001\n",
          "expectedOutput": "A0的编码是00\n"
        },
        {
          "id": "none",
          "input": "0000\n",
          "expectedOutput": "没有输入信号，编码器处于非编码状态\n"
        }
      ]
    }
  ]
